<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:orientation="vertical"
    android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp"
    android:paddingTop="8dp" android:paddingBottom="8dp">
    <TextView android:id="@+id/widget_car"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="1" android:text="AutoBilans"
        android:textColor="#F4F6F8" android:textSize="16sp" android:textStyle="bold"/>
    <TextView android:id="@+id/widget_deadline"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="32dp" android:gravity="center_vertical" android:ellipsize="end"
        android:maxLines="1" android:text="Najbliższy termin" android:textColor="#C4F45D"
        android:textSize="13sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/widget_tank"
            android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:background="@drawable/widget_action"
            android:gravity="center" android:text="Dodaj tankowanie" android:textColor="#17210A"
            android:textSize="13sp" android:textStyle="bold"/>
        <TextView android:id="@+id/widget_expense"
            android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:background="@drawable/widget_action" android:gravity="center"
            android:text="Dodaj wydatek" android:textColor="#17210A"
            android:textSize="13sp" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
